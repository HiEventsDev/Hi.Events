    "@mantine/colors-generator": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/dropzone": "^9.7.2",
    "@mantine/form": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/modals": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@mantine/nprogress": "^9.7.2",
    "@mantine/schedule": "^9.7.2",
    "@mantine/tiptap": "^9.7.2",
    "@react-pdf/renderer": "^4.5.1",
    "@scalar/api-reference-react": "0.9.83",
    "@sentry/node": "^10.73.0",
    "@stripe/react-stripe-js": "^2.1.1",
    "@stripe/stripe-js": "^1.54.1",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "^8.21.3",
