    "@tiptap/react": "^3.3.0",
    "@tiptap/starter-kit": "^3.3.0",
    "axios": "^1.4.0",
    "chroma-js": "^3.1.2",
    "classnames": "^2.3.2",
    "collect.js": "^4.36.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.8",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "invariant": "2.2.4",
    "proxy-addr": "~2.0.7",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
