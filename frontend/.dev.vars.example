# Copy to .dev.vars for local `yarn dev:cf` / `wrangler dev`.
# VITE_API_URL_SERVER must be a publicly reachable HTTPS Laravel API URL
# (Workers cannot reach Docker-internal hostnames like http://backend).

VITE_API_URL_CLIENT=https://api.example.com
VITE_API_URL_SERVER=https://api.example.com
VITE_FRONTEND_URL=http://localhost:8787
VITE_APP_NAME=Hi.Events
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_FATHOM_SITE_ID=
